# Copiez ce fichier en ".env" et remplissez vos valeurs.
# Ne commitez JAMAIS votre .env réel (il contient l'URL du webhook).

# URL du webhook Discord (Paramètres du salon > Intégrations > Webhooks > Nouveau webhook > Copier l'URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Domaine Vinted à utiliser (vinted.fr, vinted.de, vinted.be, vinted.it, ...)
VINTED_DOMAIN=vinted.fr

# Intervalle entre deux vérifications, en secondes. Le bot fait UNE seule
# requête Vinted par cycle (toutes marques regroupées), donc une valeur
# basse reste raisonnable. Si vous voyez des erreurs 403 répétées dans les
# logs, remontez cette valeur (ex: 60).
CHECK_INTERVAL_SECONDS=20

# Fichiers de config / état / logs (chemins relatifs au dossier du bot)
CONFIG_PATH=config.yaml
STATE_PATH=seen_items.json
LOG_PATH=bot.log
